# 复制为仓库根目录的 .env 并填写真实值；docker-compose-dev.yaml 会读取该文件。
# 未列出的内部参数都有安全默认值，不需要在 .env 中重复维护。

API_PORT=6000
WEB_CONCURRENCY=4
WEB_THREADS=8
BACKEND_IMAGE=jira-automation-backend:latest

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jira_automation
MYSQL_USERNAME=jira_automation
MYSQL_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

AUTH_USERS_FILE=/data/users.csv
ACCOUNT_REQUEST_PROVIDER=mock
ACCOUNT_REQUEST_API_URL=

GIT_BASE_URL=https://code.in.wezhuiyi.com/
GIT_USER=
GIT_PASSWORD=
GITLAB_PRIVATE_TOKEN=

OPENAI_URL=https://newapi.in.wezhuiyi.com/v1
OPENAI_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_STYLE=responses
# 图片识别的单次模型调用超时（秒）。只作用于截图识别，不影响文本日志分析。
OPENAI_TIMEOUT=120
# 知识机器人等待截图识别的上限（秒），超时会提示改发文字或更小的截图。
KNOWLEDGE_IMAGE_TIMEOUT=150
# 企业微信图片默认走多模态识别；本地 PaddleOCR 仅作为显式开启后的降级通道。
LOCAL_OCR_ENABLED=false

SKILL_API_TOKEN=local-dev-token
SKILL_URL_ALLOWED_HOSTS=jira.in.wezhuiyi.com
# 技能任务在 Redis 队列中的最长等待时间（秒）与过期扫描周期（秒）。
SKILL_QUEUE_TTL_SECONDS=3600
SKILL_QUEUE_SWEEP_INTERVAL_SECONDS=60
JIRA_BASE_URL=https://jira.in.wezhuiyi.com
JIRA_TOKEN=
CODEX_BASE_URL=https://newapi.in.wezhuiyi.com/v1
CODEX_API_KEY=
DEVOPS_MCP_TOKEN=

# 企业微信代码问答机器人：只在这里维护 BotID/Secret，项目与分支映射见 backend/config/chatbot.json。
CHATBOT_BOT_ID=
CHATBOT_BOT_SECRET=

# 第二个机器人（知识库/故障分析）：与上面的 CHATBOT_BOT_ID 完全隔离。
# 同一个 .env 同时维护两套凭据，两个服务只读取各自 profile 对应的 key。
CHATBOT_KNOWLEDGE_ID=
CHATBOT_KNOWLEDGE_SECRET=
CHATBOT_KNOWLEDGE_QUEUE=chatbot-knowledge
# 可选：知识机器人单独使用某个后端镜像；留空时回退 BACKEND_IMAGE。
KNOWLEDGE_BACKEND_IMAGE=

# ---- 现场 bug 提单（知识机器人 /提bug）----
# 关闭后 /提bug 只提示功能未开启，不影响问答与故障分析。
BUG_REPORT_ENABLED=true
# 现场bug 的问题类型 ID（Jira createmeta 里的 issuetype id）。
BUG_REPORT_ISSUE_TYPE_ID=10203
# 提单人回写要求 Jira 令牌账号具备 MODIFY_REPORTER（修改报告人）权限；
# 没有该权限时仍能建单，但提单人会退回为令牌账号，回复里会明确提示。
# 企业微信 userid 与 Jira 登录名不一致时在这里做映射，JSON 对象；留空则直接使用 userid。
# 例如：{"zhangsan":"zhangsan1193"}
BUG_REPORT_USER_MAP=
# 截图与日志的本地暂存目录；与知识机器人工作区共用，上传成功后立即删除。
BUG_REPORT_ATTACHMENT_DIR=/data/skill-workspace-knowledge/bug-attachments
BUG_REPORT_CACHE_DIR=/data/skill-workspace-knowledge/bug-cache

# Confluence 只读检索：知识问答只依据这些页面回答，未配置时明确提示未找到依据。
CONFLUENCE_URL=
CONFLUENCE_AUTH_MODE=bearer
CONFLUENCE_TOKEN=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_ONLINE_SPACE_KEYS=
# true = 只检索上面配置的空间，证据不足时也不扩大到全部可访问空间。
CONFLUENCE_STRICT_SPACE=false
CONFLUENCE_LABELS=
CONFLUENCE_ROOT_PAGE_IDS=
CONFLUENCE_TLS_VERIFY=true
CONFLUENCE_TIMEOUT_SECONDS=30
KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_CHUNKS=6
KNOWLEDGE_MIN_SCORE=0.15

LOGGING_LEVEL=INFO

# ---- 值周数据定时同步（duty-sync-knowledge 容器）----
# provider=browser：用无头 Chromium 常驻登录态，定时导出腾讯文档（默认）；
# provider=file：只从 DUTY_SOURCE_DIR 读取人工导出的 xlsx；
# provider=off：关闭同步，继续使用现有 duty_roster.json。
DUTY_SYNC_PROVIDER=browser
DUTY_SYNC_INTERVAL_MINUTES=60
# 逗号分隔；留空使用代码里内置的两张值周表。
DUTY_DOC_URLS=
# 过期提示阈值：快照超过这么多天没同步成功时，回答里会提示“可能不是最新”。
DUTY_STALE_DAYS=14
# 登录态失效时等待扫码的秒数；二维码截图写到日志目录。
DUTY_LOGIN_TIMEOUT_SECONDS=300
DUTY_SYNC_IMAGE=
