# 复制为仓库根目录的 .env 并填写真实值；docker-compose-dev.yaml 会读取该文件。
# 未列出的内部参数都有安全默认值，不需要在 .env 中重复维护。

API_PORT=6000
WEB_CONCURRENCY=4
WEB_THREADS=8
BACKEND_IMAGE=jira-automation-backend:latest

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jira_automation
MYSQL_USERNAME=jira_automation
MYSQL_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

AUTH_USERS_FILE=/data/users.csv
ACCOUNT_REQUEST_PROVIDER=mock
ACCOUNT_REQUEST_API_URL=

GIT_BASE_URL=https://code.in.wezhuiyi.com/
GIT_USER=
GIT_PASSWORD=
GITLAB_PRIVATE_TOKEN=

OPENAI_URL=https://newapi.in.wezhuiyi.com/v1
OPENAI_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_STYLE=responses
# 企业微信图片默认走多模态识别；本地 PaddleOCR 仅作为显式开启后的降级通道。
LOCAL_OCR_ENABLED=false

SKILL_API_TOKEN=local-dev-token
SKILL_URL_ALLOWED_HOSTS=jira.in.wezhuiyi.com
# 技能任务在 Redis 队列中的最长等待时间（秒）与过期扫描周期（秒）。
SKILL_QUEUE_TTL_SECONDS=3600
SKILL_QUEUE_SWEEP_INTERVAL_SECONDS=60
JIRA_BASE_URL=https://jira.in.wezhuiyi.com
JIRA_TOKEN=
CODEX_BASE_URL=https://newapi.in.wezhuiyi.com/v1
CODEX_API_KEY=
DEVOPS_MCP_TOKEN=

# 企业微信代码问答机器人：只在这里维护 BotID/Secret，项目与分支映射见 backend/config/chatbot.json。
CHATBOT_BOT_ID=
CHATBOT_BOT_SECRET=

# 第二个机器人（知识库/故障分析）：与上面的 CHATBOT_BOT_ID 完全隔离。
# 同一个 .env 同时维护两套凭据，两个服务只读取各自 profile 对应的 key。
CHATBOT_KNOWLEDGE_ID=
CHATBOT_KNOWLEDGE_SECRET=
CHATBOT_KNOWLEDGE_QUEUE=chatbot-knowledge
# 可选：知识机器人单独使用某个后端镜像；留空时回退 BACKEND_IMAGE。
KNOWLEDGE_BACKEND_IMAGE=

# Confluence 只读检索：知识问答只依据这些页面回答，未配置时明确提示未找到依据。
CONFLUENCE_URL=
CONFLUENCE_AUTH_MODE=bearer
CONFLUENCE_TOKEN=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_ONLINE_SPACE_KEYS=
CONFLUENCE_LABELS=
CONFLUENCE_ROOT_PAGE_IDS=
CONFLUENCE_TLS_VERIFY=true
CONFLUENCE_TIMEOUT_SECONDS=30
KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_CHUNKS=6
KNOWLEDGE_MIN_SCORE=0.15

LOGGING_LEVEL=INFO
