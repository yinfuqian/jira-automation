# 复制为仓库根目录的 .env 并填写真实值（docker compose 与本地启动都用这一份文件）。
# 根 .env 是配置的唯一权威来源：应用启动时先读 backend/.env 再读它，根 .env 中的键一律优先。
# 不要把生产密钥写进这个被提交进仓库的示例文件。

API_PORT=5000
FRONTEND_PORT=8080
MYSQL_EXPOSE_PORT=3306
REDIS_EXPOSE_PORT=6379

# 可替换为企业内部镜像仓库。默认使用国内可访问的镜像代理。
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.10-slim-bookworm
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.4-alpine
WEB_CONCURRENCY=4
WEB_THREADS=8
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=300
CELERY_WORKER_CONCURRENCY=4
BACKEND_IMAGE=jira-automation-backend:latest
FRONTEND_IMAGE=jira-automation-frontend:latest
APT_MIRROR=https://mirrors.aliyun.com/debian
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/data/upload
LOG_DIR=/app/app/logs
LOGGING_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jira_automation
MYSQL_USERNAME=jira_automation
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=root-change-me
SQLALCHEMY_POOL_RECYCLE=1800

# Docker Compose 默认使用外部依赖；填写外部地址后直接执行 docker compose up。
# 需要 Compose 启动本地 MySQL/Redis 时使用 --profile local-deps。
COMPOSE_MYSQL_HOST=
COMPOSE_MYSQL_PORT=3306

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SOCKET_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=60
REDIS_HEALTH_CHECK_INTERVAL=30
COMPOSE_REDIS_HOST=
COMPOSE_REDIS_PORT=6379
CELERY_BROKER_SOCKET_TIMEOUT=360
CELERY_BROKER_POOL_LIMIT=10
CELERY_VISIBILITY_TIMEOUT=7200

# Hot-reloaded CSV columns: username,password,status (1=enabled, 0=disabled, 2=forced offline).
# Relative paths are resolved from backend/. Docker Compose overrides this with /data/users.csv.
AUTH_USERS_FILE=../users.csv
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
ACCOUNT_REQUEST_PROVIDER=mock
ACCOUNT_REQUEST_API_URL=
ACCOUNT_REQUEST_API_TOKEN=
ACCOUNT_REQUEST_API_TIMEOUT=10
# HTTP 提供方字段映射：username -> register_account，applicant_name -> register_user，password -> register_pwd。
# 接口响应 JSON 的 code 必须为 200，否则客户端提示账号申请失败并联系管理员。

# Optional: embedded into the Windows client by windows-client/build-exe.bat.
# When omitted, the packaged client defaults to http://127.0.0.1:5000.
# WINDOWS_CLIENT_BACKEND_URL=https://example.com/logapi

# jira-code 技能用这些凭据拉取分支并推送代码；GITLAB_PRIVATE_TOKEN 需要具备仓库写权限。
GIT_BASE_URL=https://gitlab.example.com/
GIT_USER=
GIT_PASSWORD=
GITLAB_PRIVATE_TOKEN=
GITLAB_PROJECT_MEMBERSHIP_ONLY=false
GITLAB_API_TIMEOUT=30
GITLAB_API_MAX_RETRIES=3
GITLAB_API_RETRY_DELAY=1
GITLAB_DB_MAX_RETRIES=2
GITLAB_SYNC_SKIP_EXISTING_REPOS=true

OPENAI_KEY=
OPENAI_URL=https://api.deepseek.com
OPENAI_MODEL=gpt-5.6-sol
# chat: /v1/chat/completions; responses: /v1/responses
OPENAI_API_STYLE=chat
OPENAI_REASONING_EFFORT=high
LOG_ERROR_CONTEXT_LINES=10
LOG_CONTEXT_MAX_CHARS=30000
# 图片识别默认走多模态模型；本地 PaddleOCR 通道默认停用（设为 true 才启用，模型缓存见 PADDLE_PDX_CACHE_HOME）。
LOCAL_OCR_ENABLED=false
OCR_MIN_CONFIDENCE=0.45
# 仅在 LOCAL_OCR_ENABLED=true 时生效：本地 OCR 置信度低于该值时改用模型识别。
OCR_GPT_FALLBACK_CONFIDENCE=0.6
PADDLE_PDX_CACHE_HOME=/data/paddle-cache

# ===== 技能执行（Codex Agent）=====
# 以下为已验证可用的默认值，除标注「必填」的三项（JIRA_TOKEN、JIRA_BASE_URL、CODEX_API_KEY）外均可直接沿用。
# 外部系统调用 /skill 接口时使用独立令牌；默认值仅用于本地验证，生产环境必须替换为随机强令牌。
SKILL_API_TOKEN=local-dev-token
# jira_url 允许的主机白名单，逗号分隔；留空表示不限制。
SKILL_URL_ALLOWED_HOSTS=jira.in.wezhuiyi.com
# 交付物下载票据的签名密钥：任务详情里的 download_url 靠它签发的短时效票据在浏览器直接下载。
# 留空时回退 SKILL_API_TOKEN；生产环境建议单独填一个随机值，便于轮换票据而不影响接口调用。
SKILL_ARTIFACT_TICKET_SECRET=
# 票据有效期（秒），默认 30 分钟。
SKILL_ARTIFACT_TICKET_TTL=1800
# 技能脚本回写故障分析时调用的服务地址：容器内默认指向 api 服务，宿主网络部署时改为 http://127.0.0.1:5000。
ANALYSIS_API_BASE_URL=http://api:5000
# 技能脚本调用 /analysis、/logfile 等接口使用的内部令牌，默认值仅用于本地验证，生产环境必须替换为随机强令牌。
ANALYSIS_API_TOKEN=local-dev-analysis-token
# 内部令牌可访问的接口路径前缀，逗号分隔；留空时回落到默认范围（不改配置即可用）。
ANALYSIS_API_TOKEN_PATHS=/analysis,/logfile,/product/get,/module/get,/module/search
ANALYSIS_API_USERNAME=analysis-skill
# 【必填】技能访问 Jira 用的令牌与站点地址，后端注入技能进程后即锁定为唯一来源：
# 技能脚本只认这两项环境变量，不会回落到令牌文件，也不接受 --token / --base-url 改地址。
# JIRA_BASE_URL 必须与令牌所属站点一致，技能只允许访问这个地址。
JIRA_TOKEN=
JIRA_BASE_URL=https://jira.in.wezhuiyi.com
# 流水线 MCP：jira-code 的热更新阶段通过 pipeline-integration-mcp 把改动热更新到方案指定环境。
# DEVOPS_MCP_URL 留空时回落到内置默认地址；DEVOPS_MCP_TOKEN 在流水线平台个人中心签发，留空则跳过热更新。
DEVOPS_MCP_URL=https://devops.ks1.wezhuiyi.com/mcp
DEVOPS_MCP_TOKEN=
# 构建后端镜像时使用的 Codex CLI 版本与 npm 源。
CODEX_CLI_VERSION=0.142.5
NPM_REGISTRY=https://registry.npmmirror.com
# 留给技能执行的 Codex 模型参数；CODEX_API_KEY 为空时回退到 OPENAI_KEY。
CODEX_MODEL=codex/deepseek-flash
CODEX_MODEL_PROVIDER=skillrun
CODEX_BASE_URL=https://newapi.in.wezhuiyi.com/v1
# 【必填】Codex 使用的模型中转令牌。
CODEX_API_KEY=
CODEX_API_KEY_ENV=CODEX_SKILL_API_KEY
CODEX_WIRE_API=responses
CODEX_REASONING_EFFORT=high
CODEX_SANDBOX=danger-full-access
CODEX_EPHEMERAL=true
# 单次技能执行超时秒数；留空表示按技能自身 runtime.json 声明（jira-code 7200、jira-defect-gate 3600、其余 1800）。
CODEX_SKILL_TIMEOUT=
# 连续多少次网络错误后判定模型/Jira 不可达并提前终止（默认 3）。
CODEX_NETWORK_RETRY_LIMIT=10
# worker 启动时把上一次遗留的“执行中”任务标记为失败（默认 true）。
SKILL_RECOVER_ORPHANS=true
