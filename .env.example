# 复制为仓库根目录的 .env 并填写真实值；docker-compose-dev.yaml 会读取该文件。
# 未列出的内部参数都有安全默认值，不需要在 .env 中重复维护。

API_PORT=6000
WEB_CONCURRENCY=4
WEB_THREADS=8
# 各类 Celery worker 的并发数；未配置时 Compose 保留原默认值。
ANALYSIS_WORKER_CONCURRENCY=12
SKILL_WORKER_CONCURRENCY=12
CHATBOT_WORKER_CONCURRENCY=12
KNOWLEDGE_WORKER_CONCURRENCY=12
BACKEND_IMAGE=jira-automation-backend:latest

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jira_automation
MYSQL_USERNAME=jira_automation
MYSQL_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

AUTH_USERS_FILE=/data/users.csv
ACCOUNT_REQUEST_PROVIDER=mock
ACCOUNT_REQUEST_API_URL=

GIT_BASE_URL=https://code.in.wezhuiyi.com/
GIT_USER=
GIT_PASSWORD=
GITLAB_PRIVATE_TOKEN=

OPENAI_URL=https://newapi.in.wezhuiyi.com/v1
OPENAI_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_STYLE=responses

SKILL_API_TOKEN=local-dev-token
SKILL_URL_ALLOWED_HOSTS=jira.in.wezhuiyi.com
# 技能任务在 Redis 队列中的最长等待时间（秒）与过期扫描周期（秒）。
SKILL_QUEUE_TTL_SECONDS=3600
SKILL_QUEUE_SWEEP_INTERVAL_SECONDS=60
JIRA_BASE_URL=https://jira.in.wezhuiyi.com
JIRA_TOKEN=
CODEX_BASE_URL=https://newapi.in.wezhuiyi.com/v1
CODEX_API_KEY=
DEVOPS_MCP_TOKEN=

# 企业微信代码问答机器人：只在这里维护 BotID/Secret，项目与分支映射见 backend/config/chatbot.json。
CHATBOT_BOT_ID=
CHATBOT_BOT_SECRET=
# 故障分析默认开启；单次最多检出 4 个最相关的模块。
FAULT_ANALYSIS_ENABLED=true
FAULT_ANALYSIS_MAX_MODULES=4
# Confluence 只读知识问答：先保持关闭，配置地址和令牌后再启用。
KNOWLEDGE_ENABLED=false
CONFLUENCE_URL=
CONFLUENCE_AUTH_MODE=bearer
CONFLUENCE_TOKEN=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
KNOWLEDGE_SYNC_INTERVAL_SECONDS=21600
KNOWLEDGE_SPACE_KEYS=
KNOWLEDGE_LABELS=
KNOWLEDGE_ROOT_PAGE_IDS=
KNOWLEDGE_SYNC_PAGE_LIMIT=5000
# 可选语义召回；留空时自动使用关键词检索。
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_URL=
KNOWLEDGE_EMBEDDING_API_KEY=
LOGGING_LEVEL=INFO
