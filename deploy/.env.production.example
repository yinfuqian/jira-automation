# Docker runtime configuration for jira-automation.
# 复制为部署目录下的 .env.production 并填写真实值：docker-compose-prod.yaml 通过 env_file 读取它。
# 应用启动时先读 backend/.env 再读根 .env，根 .env 中的键一律优先。
# Keep this file local. It may contain credentials.
ENV_FILE=.env.production
API_PORT=5000
WEB_CONCURRENCY=4
CELERY_WORKER_CONCURRENCY=4
WEB_THREADS=8
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=300
PYTHON_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/k8s-docker-image-yfq/python:3.10-slim
APT_MIRROR=https://mirrors.aliyun.com/debian
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/data/upload
LOG_DIR=/app/app/logs
LOGGING_LEVEL=DEBUG
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=jira_automation
MYSQL_USERNAME=your-mysql-user
MYSQL_PASSWORD=change-me
SQLALCHEMY_POOL_RECYCLE=1800
REDIS_HOST=your-redis-host
REDIS_PORT=16379
REDIS_DATABASE=0

# Authentication and account requests
AUTH_USERS_FILE=../users.csv
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
# 账号申请通过 HTTP 邮件接口发送，不在本地保存申请记录。
# 字段映射：用户名->register_account，申请人姓名->register_user，密码->register_pwd。
ACCOUNT_REQUEST_PROVIDER=http
ACCOUNT_REQUEST_API_URL=https://example.com/prod-api/open/api/sendEmail
# 当前接口未要求 Bearer Token，保持为空；后续需要鉴权时再填写。
ACCOUNT_REQUEST_API_TOKEN=
# HTTP 超时时间（秒）；HTTP 或业务 code 非 200 时统一提示联系管理员。
ACCOUNT_REQUEST_API_TIMEOUT=10
# 图片识别默认走多模态模型；本地 PaddleOCR 通道默认停用。
LOCAL_OCR_ENABLED=false
OCR_MAX_SIDE_LIMIT=2400
OCR_MIN_CONFIDENCE=0.45
OCR_GPT_FALLBACK_CONFIDENCE=0.6
WINDOWS_CLIENT_BACKEND_URL=https://example.com/zhuiyi/logapi

REDIS_USERNAME=default
REDIS_PASSWORD=change-me
# jira-code 技能用这些凭据拉取分支并推送代码；GITLAB_PRIVATE_TOKEN 需要具备仓库写权限。
GIT_BASE_URL=https://git.example.com/
GIT_USER=your-git-username
GIT_PASSWORD=change-me
GITLAB_PRIVATE_TOKEN=change-me
GITLAB_PROJECT_MEMBERSHIP_ONLY=false
GITLAB_API_TIMEOUT=30
GITLAB_API_MAX_RETRIES=3
GITLAB_API_RETRY_DELAY=1
GITLAB_DB_MAX_RETRIES=2
GITLAB_SYNC_SKIP_EXISTING_REPOS=true
# 本地构建产物名称；api、worker、migrate 共用同一个后端镜像。
BACKEND_IMAGE=your-registry/jira-automation-backend:latest
# 前端镜像不由 docker-compose-prod.yaml 管理，保留给单独部署流程使用。
FRONTEND_IMAGE=your-registry/jira-automation-frontend:latest
OPENAI_URL=https://api.openai.com/v1
# 故障分析模型密钥；未配置时兼容 OPENAI_API_KEY，最后复用 CODEX_API_KEY。
OPENAI_KEY=sk-your-api-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high

OPENAI_API_STYLE=responses
LOG_ERROR_CONTEXT_LINES=10
LOG_CONTEXT_MAX_CHARS=30000

# ===== 技能执行（Codex Agent）=====
# 以下为已验证可用的默认值，除标注「必填」的三项（JIRA_TOKEN、JIRA_BASE_URL、CODEX_API_KEY）外均可直接沿用。
# 外部系统调用 /skill 接口时使用独立令牌。默认值是本地验证令牌，
# 生产环境必须替换为随机强令牌，否则任何知道该默认值的人都能调用技能接口。
SKILL_API_TOKEN=local-dev-token
# jira_url 允许的主机白名单，逗号分隔；留空表示不限制，生产环境建议保持填写。
SKILL_URL_ALLOWED_HOSTS=jira.in.wezhuiyi.com
# 交付物下载票据的签名密钥：任务详情里的 download_url 靠它签发的短时效票据在浏览器直接下载。
# 留空时回退 SKILL_API_TOKEN，生产环境建议单独填写随机强令牌（如 openssl rand -hex 32 的输出）。
SKILL_ARTIFACT_TICKET_SECRET=
# 票据有效期（秒），默认 30 分钟。
SKILL_ARTIFACT_TICKET_TTL=1800
# 技能脚本回写故障分析时调用的服务地址：技能与 API 同机，使用回环地址完成内部自调用。
ANALYSIS_API_BASE_URL=http://127.0.0.1:5000
# 同机回环自调用默认免令牌；关闭此项后，同机调用也必须携带令牌。
ANALYSIS_API_TRUST_LOOPBACK=true
# 仅非回环地址调用需要令牌；回环内部调用可留空。
ANALYSIS_API_TOKEN=
# 内部令牌可访问的接口路径前缀，逗号分隔；留空时回落到默认范围（不改配置即可用）。
ANALYSIS_API_TOKEN_PATHS=/analysis,/logfile,/product/get,/module/get,/module/search
ANALYSIS_API_USERNAME=analysis-skill
# 【必填】技能访问 Jira 用的令牌与站点地址，后端注入技能进程后即锁定为唯一来源：
# 技能脚本只认这两项环境变量，不会回落到令牌文件，也不接受 --token / --base-url 改地址。
# JIRA_BASE_URL 必须与令牌所属站点一致，技能只允许访问这个地址。
JIRA_TOKEN=
JIRA_BASE_URL=https://jira.in.wezhuiyi.com
# Jira 自动触发：原生 webhook 可配置 HMAC 密钥；Jira Automation 也可直接使用 SKILL_API_TOKEN。
# 自动触发接口为 POST /skill/jira/events，默认只接收新建缺陷事件并提交 jira-gate-bug。
JIRA_WEBHOOK_SECRET=
JIRA_WEBHOOK_SKILL_ID=jira-gate-bug
JIRA_WEBHOOK_EVENTS=jira:issue_created,issue_created
# 留空表示不按问题类型过滤；多个类型用逗号分隔。
JIRA_WEBHOOK_ISSUE_TYPES=缺陷,Bug
# 流水线 MCP：jira-code 的热更新阶段通过 pipeline-integration-mcp 把改动热更新到方案指定环境。
# 令牌在流水线平台个人中心签发；留空时后端不注册 MCP，热更新阶段按「跳过并说明」处理。
DEVOPS_MCP_URL=https://devops.ks1.wezhuiyi.com/mcp
DEVOPS_MCP_TOKEN=
# 留给技能执行的 Codex 模型参数；CODEX_API_KEY 为空时回退到 OPENAI_KEY。
CODEX_MODEL=codex/deepseek-flash
CODEX_MODEL_PROVIDER=skillrun
CODEX_BASE_URL=https://newapi.in.wezhuiyi.com/v1
# 【必填】Codex 使用的模型中转令牌。
CODEX_API_KEY=
CODEX_API_KEY_ENV=CODEX_SKILL_API_KEY
CODEX_WIRE_API=responses
CODEX_REASONING_EFFORT=high
CODEX_SANDBOX=danger-full-access
CODEX_EPHEMERAL=true
# 单次技能执行超时秒数；留空表示按技能自身 runtime.json 声明（jira-code 7200、jira-defect-gate 3600、其余 1800）。
CODEX_SKILL_TIMEOUT=
# 连续多少次网络错误后判定模型/Jira 不可达并提前终止（默认 3）。
CODEX_NETWORK_RETRY_LIMIT=10
# worker 启动时把上一次遗留的“执行中”任务标记为失败（默认 true）。
SKILL_RECOVER_ORPHANS=true

#OPENAI_URL=https://your-newapi.example.com/v1
#OPENAI_KEY=sk-your-api-key
#OPENAI_KEY=sk-your-api-key
